{
	"name": "@abyrd/website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"build": "NODE_ENV=production bun build --target bun src/index.ts --outdir dist",
		"start": "NODE_ENV=production bun --cwd dist index.js",
		"lint": "bunx @biomejs/biome check .",
		"typecheck": "bunx tsc --noEmit",
		"build:verify": "NODE_ENV=production TMPDIR=/tmp bun build --target bun src/index.ts --outdir /tmp/abyrd-me-build",
		"test": "bun test",
		"check": "bun run test && bun run lint && bun run typecheck && bun run build:verify",
		"deps:outdated": "TMPDIR=/tmp bun outdated --no-progress",
		"deps:update": "bun update",
		"deps:update:latest": "bun update --latest"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"bun-plugin-tailwind": "^0.1.2",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/bun": "1.3.14",
		"bun": "1.3.14",
		"typescript": "^6.0.3"
	}
}
