{
	"$schema": "https://raw.githubusercontent.com/Abyrd9/harbor-cli/main/harbor.schema.json",
	"sessionName": "abyrd",
	"services": [
		{
			"name": "website",
			"path": "./packages/website",
			"command": "bun run dev"
		},
		{
			"name": "app",
			"path": "./packages/app",
			"command": "bun run dev"
		},
		{
			"name": "opencode",
			"path": ".",
			"command": "opencode . --continue",
			"canAccess": ["website", "app"]
		}
	],
	"before": [],
	"after": []
}
